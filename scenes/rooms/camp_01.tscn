[node name="MilkRabbit" type="Node2D" parent="." unique_id=758314480 instance=ExtResource("15_ju45q")]
z_index = 20
position = Vector2(426, 544)
script = ExtResource("16_11gcn")
npc_id = &"NPC-S01"
display_name = "奶兔向导"
dialogue = PackedStringArray("篝火还亮着，这里就是我们小队今晚的家。累了就坐下，安心休息。", "补给箱给你留了药剂和奶弹。按 Tab 整理行囊，把常用物品拖到快捷栏。", "右侧林径通往巨木森林。交易台地在上方，踩着两层细枝就能上去。")
frames = ExtResource("17_edsd6")
patrol_radius = 0.0
interact_radius = 46.0
metadata/role = "guide"

[node name="MilkCow" type="Node2D" parent="." unique_id=1478635067 instance=ExtResource("15_ju45q")]
z_index = 20
position = Vector2(1090, 256)
script = ExtResource("16_11gcn")
npc_id = &"NPC-S02"
display_name = "奶牛商人"
dialogue = PackedStringArray("夜里赶路容易手忙脚乱，药剂记得放在顺手的位置。", "货物和包裹都搬上来了，这块岩台比林子里踏实多了。")
frames = ExtResource("18_k3ybc")
patrol_radius = 0.0
interact_radius = 46.0
metadata/role = "merchant"

[node name="MilkMouse" type="Node2D" parent="." unique_id=1635232403 instance=ExtResource("15_ju45q")]
z_index = 20
position = Vector2(840, 256)
script = ExtResource("16_11gcn")
npc_id = &"NPC-S03"
display_name = "奶鼠铁匠"
dialogue = PackedStringArray("铁砧摆稳，炉火烧旺，小队的武器就交给我照看。", "闪避后再找出手机会。好武器也需要沉着的手。")
frames = ExtResource("19_ncsk1")
patrol_radius = 0.0
interact_radius = 46.0
metadata/role = "blacksmith"

[node name="MilkScholar" type="Node2D" parent="." unique_id=1510101057 instance=ExtResource("15_ju45q")]
z_index = 20
position = Vector2(280, 544)
script = ExtResource("16_11gcn")
npc_id = &"NPC-S04"
display_name = "奶龙学者"
dialogue = PackedStringArray("月光照到的树冠之外，还有更古老的林地。", "这张桌上的地图记着来路。出发前，不妨再看一眼营地的位置。")
frames = ExtResource("20_nskky")
patrol_radius = 0.0
interact_radius = 46.0
metadata/role = "scholar"

[node name="MilkGuard" type="Node2D" parent="." unique_id=1414257205 instance=ExtResource("15_ju45q")]
z_index = 20
position = Vector2(1170, 544)
script = ExtResource("16_11gcn")
npc_id = &"NPC-S05"
display_name = "奶熊守卫"
dialogue = PackedStringArray("这里由我守着。营地是安全区，你可以放心整理装备。", "穿过右边那道树根，就是巨木森林。记得带上补给。")
frames = ExtResource("21_ur6f2")
patrol_radius = 0.0
interact_radius = 46.0
metadata/role = "guard"

[node name="MilkMessenger" type="Node2D" parent="." unique_id=1256566358 instance=ExtResource("15_ju45q")]
z_index = 20
position = Vector2(968, 544)
script = ExtResource("16_11gcn")
npc_id = &"NPC-S06"
display_name = "奶鸟信使"
dialogue = PackedStringArray("小队的消息都钉在这块告示板上，回来时别忘了看看。", "我会把你平安出发的消息带给大家。")
frames = ExtResource("22_u387v")
patrol_radius = 0.0
interact_radius = 46.0
metadata/role = "messenger"

