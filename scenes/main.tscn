[gd_scene load_steps=2 format=3]

; main.tscn —— 标题屏（纯 UI 节点，不引用任何外部资源文件）
; Enter/空格/左键开始新旅途；有效存档可点击继续旅途。

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1_menu"]

[node name="Main" type="Node2D"]
script = ExtResource("1_menu")

[node name="UI" type="CanvasLayer" parent="."]

[node name="Root" type="Control" parent="UI"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Background" type="ColorRect" parent="UI/Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0549, 0.051, 0.0706, 1)

[node name="Center" type="VBoxContainer" parent="UI/Root"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_top = -90.0
offset_right = 240.0
offset_bottom = 90.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="UI/Root/Center"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "奶宝：银河征途"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Subtitle" type="Label" parent="UI/Root/Center"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "灵火旅途 · 从奶泉营地启程"
horizontal_alignment = 1
color = Color(0.72, 0.72, 0.78, 1)

[node name="Hint" type="Label" parent="UI/Root/Center"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "A/D 移动 · Space 跳跃 · Shift 闪避 · S 下穿\n左键攻击 · 右键防御 · Q/E/R/F 奶术\nE 优先交互 · Tab 行囊 · 1–5 快捷物品 · Esc 暂停\nF2 战斗演练 · F3 动作预览"
horizontal_alignment = 1
color = Color(0.6, 0.6, 0.66, 1)

[node name="Version" type="Label" parent="UI/Root"]
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = -22.0
offset_right = 320.0
offset_bottom = -8.0
grow_vertical = 0
theme_override_font_sizes/font_size = 10
text = "v1.1 原型 · Godot 4.7 · 林地与灵火系统"
color = Color(0.5, 0.5, 0.55, 1)
