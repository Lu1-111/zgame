  "processing_steps": [
    "保留RAW原图及完整prompt，记录SHA-256。",
    "裁出原画连续土纹、草皮和木梁，Nearest缩至16px；对相邻边缘复用对应像素，校准可拼接边。",
    "背景等比缩放并中心裁切至640×360，压低对比，32色色板；宽房间需重复或拼接，禁止拉伸至房宽。",
    "构件按alpha包围盒机械裁切、等比Nearest缩小、32色量化，放入16倍数画布，alpha阈值160清理边缘。",
    "return_glyph从既有return_arch门内裁片提取奶蓝连通分量与高光，保持源色，Nearest等比缩至内容高28px并放入32×32透明画布；未新增RAW。"
  ],
  "composition_notes": [
    "camp_01以milk_spring为主地标，cottage给camp_02入口明确轮廓。",
    "campfire与chest形成安全停驻簇，两簇之间留出空白，不均匀铺满装饰。",
    "return_glyph置于camp_01顶部y=40平台上方，作为cave_07单向返回落点提示；96px高return_arch留作宽裕场景备用，禁止因顶边clamp导致梁穿门框。",
    "所有props推荐z_index=1，角色保持20。"
  ],
  "limitations": [
    "静态环境套件，不含交互动画、碰撞、NPC。",
    "terrain为手工接缝校准的16格基础集，不是Godot47格自动地形图。",
    "木梁为单向薄平台视觉，请由房间数据明确碰撞。"
  ],
