    "cards": [
      {
        "title": "首次推进",
        "kind": "main",
        "lines": [
          "S先看到G1关闭，再从A下探。",
          "A→B→J→C；C可落到D开门，再去T。",
          "也可从A绕湿根W到J；J的两路会合于C。"
        ],
        "flow": [
          "S",
          "A",
          "B",
          "J",
          "C",
          "T"
        ]
      },
      {
        "title": "G1开通后：服务T的重试",
        "kind": "shortcut",
        "lines": [
          "S→D→C→T，跳过根下探索与东侧攀升。",
          "开门不要求先战胜T。",
          "原干洞、湿洞仍可回访取资源。"
        ],
        "flow": [
          "S",
          "D",
          "C",
          "T"
        ]
      },
      {
        "title": "空间里真正的取舍",
        "kind": "branch",
        "lines": [
          "干洞：较直接，有飞行敌人打断地面节奏。",
          "湿洞：向下探得更深，箱子位于折返支环。",
          "J上行：开阔跳跃；K花道：低顶限制腾空。"
        ]
      },
      {
        "title": "需要灰盒验证",
        "kind": "muted",
        "lines": [
          "门体须封满通道，不能从顶棚或下沿绕过。",
          "C至D的落点先可见，D→C保持可返回。",
          "上升主路以≤96世界像素的台阶为目标。"
        ]
      }
